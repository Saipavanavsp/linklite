PORT=3000
BASE_URL=http://localhost:3000

# sqlite (default, no setup needed) or postgres
DB_DRIVER=sqlite
DB_PATH=./data/linklite.db

# only used when DB_DRIVER=postgres. Run `npm run migrate` once to create the tables.
# DATABASE_URL=postgres://linklite:change-me@localhost:5432/linklite
# PG_POOL_MAX=10
# ids each instance reserves at a time from the shared counter
# ID_BLOCK_SIZE=100

# number of links kept in the in-memory LRU cache
CACHE_SIZE=1000

# general limit for every request (burst size, tokens added per second)
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL=1

# stricter limit for POST /api/shorten
SHORTEN_LIMIT_CAPACITY=10
SHORTEN_LIMIT_REFILL=0.2

# set to 1 when running behind a reverse proxy so req.ip uses X-Forwarded-For
TRUST_PROXY=0
