{
  "name": "linklite",
  "version": "1.0.0",
  "description": "URL shortener with a hand-written LRU cache and token bucket rate limiter",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "jest"
  },
  "keywords": [
    "url-shortener",
    "lru-cache",
    "rate-limiter",
    "express"
  ],
  "author": "Sai Pavan",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "jest": {
    "testEnvironment": "node"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "@parcel/watcher": true,
    "unrs-resolver": true
  }
}
