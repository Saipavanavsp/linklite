{
  "name": "linklite",
  "version": "1.0.0",
  "description": "URL shortener with a hand-written LRU cache and token bucket rate limiter",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "loadtest": "node scripts/loadtest.js"
  },
  "keywords": [
    "url-shortener",
    "lru-cache",
    "rate-limiter",
    "express",
    "redis",
    "postgresql",
    "docker"
  ],
  "author": "Sai Pavan",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/integration/"
    ]
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "ioredis": "^5.11.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  },
  "allowScripts": {
    "better-sqlite3": false,
    "@parcel/watcher": true,
    "unrs-resolver": true
  }
}
